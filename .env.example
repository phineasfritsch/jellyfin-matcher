PORT=3000
JELLYFIN_URL=http://192.168.1.100:8096
JELLYFIN_API_KEY=your_jellyfin_api_key_here
JELLYSEERR_URL=http://192.168.1.100:5055
JELLYSEERR_API_KEY=your_jellyseerr_api_key_here
MDBLIST_API_KEY=your_mdblist_api_key_here

# Most requests one deck build may spend on ratings. The free tier is metered
# per day and a cold cache asks for ten titles per request, so a large library
# could otherwise spend the whole key on one room. Titles past the budget are
# left unrated and the server logs how many. /healthz reports the remaining
# quota and what the last build cost.
# MDBLIST_REQUEST_BUDGET=40

# Comma-separated origins allowed to open a websocket. Leave unset unless you
# serve the front end from a different host than this process: the UI is served
# by the app itself, so same-origin is correct and is the default.
# MATCHER_ALLOWED_ORIGINS=https://match.example.com

# Who has to sign in with a Jellyfin account. Auth gates capability, not the
# whole app, so account-less friends can still join a room you share.
#   requests (default) - login only to switch a room to "Any Movie" or to fire
#                        a request. A Jellyfin-only night needs no login.
#   create             - login to create any room; joining stays open.
#   all                - login to create and to join.
#   off                - no login anywhere.
# MATCHER_AUTH=requests
