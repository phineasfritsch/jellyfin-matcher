{
  "name": "jellyfin-matcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --env-file=.env server/index.ts",
    "build": "next build",
    "start": "tsx --env-file=.env server/index.ts",
    "e2e": "tsx scripts/e2e-session.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gate": "tsx scripts/gate.ts",
    "inventory": "tsx scripts/inventory.ts",
    "prod:read": "tsx --env-file-if-exists=.env scripts/health.ts",
    "e2e:walkout": "node scripts/e2e-walkout.cjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.22",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "next": "^15.5.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "socket.io": "^4.8.3"
  }
}
