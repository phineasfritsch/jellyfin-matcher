{
  "name": "jellyfin-matcher",
  "version": "0.9.0",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx --env-file=.env server/index.ts",
    "build": "next build",
    "start": "tsx --env-file=.env server/index.ts",
    "e2e": "tsx scripts/e2e-session.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gate": "tsx scripts/gate.ts",
    "mutate": "tsx scripts/mutate.ts",
    "measure:rows": "tsx scripts/measure-rows.ts",
    "measure:reflow": "tsx scripts/measure-reflow.ts",
    "inventory": "tsx scripts/inventory.ts",
    "prod:read": "tsx --env-file-if-exists=.env scripts/health.ts",
    "e2e:walkout": "node scripts/e2e-walkout.cjs",
    "counts": "tsx scripts/sync-counts.ts",
    "shots": "tsx scripts/screenshots.ts",
    "rulings": "tsx scripts/rulings.ts",
    "e2e:two": "tsx scripts/e2e-two-phones.ts",
    "contrast": "tsx scripts/contrast.ts",
    "e2e:restart": "tsx scripts/e2e-restart.ts",
    "probe:userscope": "tsx scripts/probe-user-scope.ts",
    "measure:spacing": "tsx scripts/measure-spacing.ts",
    "contrast:tokens": "tsx scripts/contrast-tokens.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.22",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "next": "^15.5.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}
